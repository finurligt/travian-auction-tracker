{
  "manifest_version": 3,
  "name": "Travian Auction Tracker",
  "version": "0.5.1",
  "description": "Manually capture finished Travian auctions from the page you are looking at and keep statistics. Read-only: never clicks or changes anything on the page.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "Travian Auction Tracker",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "travian-auction-tracker@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "background": {
    "page": "background/background.html"
  }
}
